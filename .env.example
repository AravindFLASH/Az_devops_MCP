# Azure DevOps Configuration
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/YOUR_ORG
AZURE_DEVOPS_PROJECT=YOUR_PROJECT

# MCP transport runtime
# stdio for local desktop MCP clients, streamable-http for hosted/public endpoint.
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp

# Authentication Mode: pat | oauth | managed_identity | service_principal | auto
AZURE_DEVOPS_AUTH_MODE=oauth

# OAuth (Microsoft Entra ID device code flow)
AZURE_DEVOPS_TENANT_ID=your-tenant-id
AZURE_DEVOPS_CLIENT_ID=your-client-id

# PAT (Personal Access Token) - optional, used if AUTH_MODE=pat
# AZURE_DEVOPS_PAT=your_pat_token_here

# Managed Identity (Azure container/VM only)
# AZURE_DEVOPS_MI_CLIENT_ID=optional-user-assigned-identity-client-id

# Service Principal (non-interactive)
# AZURE_DEVOPS_SP_TENANT_ID=sp-tenant-id
# AZURE_DEVOPS_SP_CLIENT_ID=sp-client-id
# Either secret or certificate (not both):
# AZURE_DEVOPS_SP_CLIENT_SECRET=sp-secret
# AZURE_DEVOPS_SP_CERT_PATH=/path/to/cert.pem
# AZURE_DEVOPS_SP_CERT_PASSWORD=cert-password-if-encrypted
